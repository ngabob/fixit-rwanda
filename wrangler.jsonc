{
  "name": "fixit-rwanda",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "fixit-rwanda" }],
  "ratelimits": [{
    "name": "AUTH_LIMIT",
    "namespace_id": "1001",
    "simple": { "limit": 12, "period": 60 }
  }]
}
